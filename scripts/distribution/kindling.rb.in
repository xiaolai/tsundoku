cask "kindling" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/<owner>/kindling/releases/download/v#{version}/Kindling-#{version}.dmg"
  name "Kindling"
  desc "Local Kindle annotations, history, PDF export and an AI reading companion"
  homepage "https://github.com/<owner>/kindling"

  livecheck do
    url :homepage
    strategy :github_latest
  end

  depends_on macos: :sequoia
  app "Kindling.app"
  uninstall quit: "com.example.kindling"
end
